# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testsimplify

# ── NextAuth configuration ────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-this-with-a-random-string

# ── Encryption key for secrets (Jira tokens, CI tokens, etc.) ─
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Optional OAuth providers ──────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict Google sign-in to a specific domain (e.g. "mycompany.com")
GOOGLE_ALLOWED_DOMAIN=

# ── Mail provider (Mailhog in docker-compose) ─────────────────
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="TestSimply <noreply@testsimplify.local>"

# ── Toggle email/password auth ────────────────────────────────
# Set to "true" to disable the credentials provider
EMAIL_PASSWORD_DISABLED=false

# ── Logging ───────────────────────────────────────────────────
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ── File uploads ──────────────────────────────────────────────
# Directory for local file storage (defaults to ./uploads)
# UPLOAD_DIR=/app/uploads
# Public base URL for uploaded files
# UPLOAD_URL_BASE=/uploads
