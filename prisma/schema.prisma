generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@localhost:5432/testsimplify"
}

enum Role {
  ADMIN
  LEAD
  TESTER
  VIEWER
}

enum TestStatus {
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  ACTIVE
  COMPLETED
  BLOCKED
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  emailVerified    DateTime?
  password         String?
  role             Role            @default(VIEWER)
  image            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  testCases        TestCase[]      @relation("TestCaseOwner")
  executions       TestExecution[] @relation("ExecutionCreator")
  accounts         Account[]
  sessions         Session[]
  apiTokens        PersonalAccessToken[]
  leadProjects     Project[]       @relation("ProjectLeads")
  assignedProjects Project[]       @relation("ProjectMembers")
}

model PersonalAccessToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String
  label     String
  scopes    String[]
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model Project {
  id               String            @id @default(cuid())
  key              String
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  testCases        TestCase[]
  plans            TestPlan[]
  executions       TestExecution[]
  requirementLinks RequirementLink[]
  settings         ProjectSetting?
  testSets         TestSet[]
  preconditions    Precondition[]
  environments     Environment[]
  bugs             Bug[]
  counters         ProjectCounter[]
  leads            User[]            @relation("ProjectLeads")
  members          User[]            @relation("ProjectMembers")

  @@unique([key])
}

model ProjectSetting {
  id           String     @id @default(cuid())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String     @unique
  tags         String[]   @default([])
  components   String[]   @default([])
  environments String[]   @default([])
  priorities   Priority[] @default([LOW, MEDIUM, HIGH, CRITICAL])
  jiraUrl      String?
  jiraEmail    String?
  jiraApiToken String?
  ciProvider   String?
  ciUrl        String?
  ciToken      String?
  ciWorkflowId String?
}

model TestCase {
  id            String     @id @default(cuid())
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  key           String
  name          String
  description   String?
  preconditionsText String?
  steps         Json
  expected      String?
  priority      Priority   @default(MEDIUM)
  status        String     @default("Draft")
  tags          String[]   @default([])
  component     String?
  owner         User?      @relation("TestCaseOwner", fields: [ownerId], references: [id])
  ownerId       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  plans         TestCasePlan[]
  results       TestResult[]
  requirements  RequirementLink[]
  attachments   Attachment[]

  @@unique([projectId, key])
  @@index([projectId])
  testSets      TestSet[]
  preconditions Precondition[]

  // Flakiness & Automation
  isFlaky         Boolean   @default(false)
  flakyDetectedAt DateTime?
  isAutomated     Boolean   @default(false)
  automationId    String?
  bugs            Bug[]
}

model TestSet {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  key         String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cases       TestCase[]
  bugs        Bug[]

  @@unique([projectId, key])
}

model Precondition {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  key         String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cases       TestCase[]

  @@unique([projectId, key])
}

model Environment {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  key         String
  name        String
  description String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testPlans      TestPlan[]
  testExecutions TestExecution[]

  @@unique([projectId, key])
}

model TestPlan {
  id            String          @id @default(cuid())
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  key           String
  name          String
  description   String?
  targetVersions String[]       @default([])
  environments   String[]       @default([])
  tags           String[]       @default([])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  cases         TestCasePlan[]
  executions    TestExecution[]
  environmentRelations Environment[]

  @@unique([projectId, key])
}

model TestCasePlan {
  id        String   @id @default(cuid())
  plan      TestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  case      TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([planId, caseId])
}

model TestExecution {
  id          String        @id @default(cuid())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  plan        TestPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId      String?
  key         String
  name        String
  description String?
  environment String?
  environmentRelation Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  environmentId       String?
  revision    String?
  buildUrl    String?
  commitSha   String?
  labels      String[]      @default([])
  startedAt   DateTime?
  finishedAt  DateTime?
  status      ExecutionStatus @default(ACTIVE)
  createdBy   User?         @relation("ExecutionCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  results     TestResult[]
  attachments Attachment[]

  @@unique([projectId, key])
  @@index([planId])
}


model Bug {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  key         String
  summary     String
  description String?
  status      String   @default("OPEN")
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  testResults TestResult[]
  testCase    TestCase?    @relation(fields: [testCaseId], references: [id])
  testCaseId  String?
  testSet     TestSet?     @relation(fields: [testSetId], references: [id])
  testSetId   String?

  @@unique([projectId, key])
  @@index([testCaseId])
  @@index([testSetId])
}

// Update TestResult to link to Bugs
model TestResult {
  id           String        @id @default(cuid())
  execution    TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId  String
  testCase     TestCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId       String
  status       TestStatus
  durationMs   Int?
  evidenceURLs String[]      @default([])
  errorMessage String?
  stepsLog     Json?
  retried      Boolean       @default(false)
  attempt      Int           @default(1)
  createdAt    DateTime      @default(now())

  @@index([executionId])
  @@index([caseId])

  Attachment  Attachment[]
  bugs        Bug[]
}

model RequirementLink {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseId String
  externalUrl String
  type       String
  createdAt  DateTime @default(now())
}

model Attachment {
  id           String        @id @default(cuid())
  url          String
  fileName     String
  contentType  String
  size         Int
  testCase     TestCase?     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseId   String?
  testResult   TestResult?   @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  testResultId String?
  execution    TestExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId  String?
  createdAt    DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProjectCounter {
  id        String @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  type      String
  count     Int    @default(0)

  @@unique([projectId, type])
}
